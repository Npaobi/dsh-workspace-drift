{
  "name": "dsh-workspace-drift",
  "version": "0.1.0",
  "description": "Record and compare project development environments without storing secret values.",
  "type": "module",
  "main": "dist/index.js",
  "files": ["dist", "cordis.patch.yml", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
